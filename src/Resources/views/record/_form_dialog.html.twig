{#
  The "New company / New contact" form as the fragment of the UiKit remote form dialog (0.8.0, `ui.record_create:
  dialog`): answered to `GET /{companies|contacts}/new` with `X-Nowo-Dialog: 1` (200) and to an invalid submission
  (422, re-rendered in the dialog, focus on the first invalid field). Same route, field names and CSRF token as the
  page. The Save / Cancel row (`data-nowo-ui-dialog-actions`) moves into the dialog footer; Cancel is a
  `type="button"` that closes the dialog. The form is named by the dialog title (`crm-record-dialog-title`).
  Variables: form (FormView), action (the create URL), title (translation key), testid.
#}
{%- set _b = 'NowoCrmKitBundle' -%}
<div data-testid="{{ testid }}">
    {{ form_start(form, {action: action, attr: {class: nowo_ui_class('form', _b), 'aria-labelledby': 'crm-record-dialog-title', id: 'crm-record-dialog-form'}}) }}
    {% if form.vars.errors|length > 0 %}<div class="{{ nowo_ui_class('flash_error', _b) }}" role="alert" data-testid="{{ testid }}-errors">{{ form_errors(form) }}</div>{% endif %}
    {% for child in form %}{% if not child.rendered %}{{ form_row(child) }}{% endif %}{% endfor %}
    <div class="{{ nowo_ui_class('form_actions', _b) }}" data-nowo-ui-dialog-actions>
        <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}" data-testid="{{ testid }}-submit">{{ 'form.save'|trans({}, _b) }}</button>
        <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-nowo-ui-dialog-close data-testid="{{ testid }}-cancel">{{ 'form.cancel'|trans({}, _b) }}</button>
    </div>
    {{ form_end(form) }}
</div>

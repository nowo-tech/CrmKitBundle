<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\CrmKitBundle\Domain\Model\Engagement\EngagementAttendee" table="crm_engagement_attendee">
        <indexes>
            <index name="crm_engagement_attendee_meeting" columns="tenant_id,engagement_id"/>
            <index name="crm_engagement_attendee_actor" columns="tenant_id,actor_id"/>
            <index name="crm_engagement_attendee_contact" columns="tenant_id,contact_id"/>
        </indexes>
        <id name="id" column="id" type="string" length="36"><generator strategy="NONE"/></id>
        <field name="tenantId" column="tenant_id" type="string" length="128"/>
        <field name="engagementId" column="engagement_id" type="string" length="36"/>
        <field name="actorId" column="actor_id" type="string" length="128" nullable="true"/>
        <field name="contactId" column="contact_id" type="string" length="36" nullable="true"/>
    </entity>
</doctrine-mapping>

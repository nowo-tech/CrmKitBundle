<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\CrmKitBundle\Domain\Model\Note" table="crm_note">
        <indexes>
            <index name="crm_note_subject" columns="tenant_id,subject_type,subject_id,created_at"/>
            <index name="crm_note_keyset" columns="tenant_id,subject_type,subject_id,pinned,id"/>
        </indexes>
        <id name="id" column="id" type="string" length="36"><generator strategy="NONE"/></id>
        <field name="tenantId" column="tenant_id" type="string" length="128"/>
        <field name="subjectType" column="subject_type" type="string" length="16" enum-type="Nowo\CrmKitBundle\Domain\Enum\SubjectType"/>
        <field name="subjectId" column="subject_id" type="string" length="36"/>
        <field name="body" column="body" type="text"/>
        <field name="pinned" column="pinned" type="boolean"/>
        <field name="authorId" column="author_id" type="string" length="128" nullable="true"/>
        <field name="version" column="version" type="integer" version="true"/>
        <field name="createdAt" column="created_at" type="nowo_crm_utc_datetime"/>
        <field name="updatedAt" column="updated_at" type="nowo_crm_utc_datetime_micro"/>
    </entity>
</doctrine-mapping>

{#
  The import modal of the lists (0.4.0, UiKit PAGE_CONTRACT "Dialog sizes and anatomy"): UiKit's confirm_dialog with its anatomy (`anatomy: true`), the
  wide size (`--nowo-dialog-width-wide`) and the content's height up to the viewport; the tinted header and footer are
  UiKit's. 0.4.1 (UiKit 2.63): a full-screen sheet on phones (`phone: 'sheet'`: header and footer stay, the body
  scrolls) and the steps in the header (`header_steps`, replaced by each step). js/nowo-crm-import.js opens it from any [data-crm-import-open] link (the page action "Import", whose href is
  the import page: the no-JS fallback) and loads the steps from the import routes (import/dialog.html.twig); the texts
  of the notices it builds itself are data attributes of the dialog. Rendered only for someone who may import.

  0.10.3 (`import.dialog.direct_get: redirect`, UiKit 2.74): the dialog carries UiKit's reopen contract for the id
  `crm-import-dialog` (nowo_ui_remote_dialog_reopen_attrs: the safe list of step routes and, for a reopen query, the
  step URL the router generated again); the script opens the modal on that step once the page loads.

  Variables: dialog ({url: the import page of this list}).
#}
{%- set _d = 'NowoCrmKitBundle' -%}
{% embed nowo_ui_partial('confirm_dialog', 'NowoCrmKitBundle') with {
    only_dialog: true,
    anatomy: true,
    size: 'wide',
    phone: 'sheet',
    header_steps: ['file', 'mapping', 'preview', 'result']|map((name, i) => {label: ('import.step.' ~ name)|trans({}, 'NowoCrmKitBundle'), status: i == 0 ? 'current' : 'upcoming'}),
    header_steps_label: 'import.steps'|trans({}, 'NowoCrmKitBundle'),
    title: 'import.title'|trans({}, 'NowoCrmKitBundle'),
    title_id: 'crm-import-dialog-title',
    close_label: 'import.dialog.close'|trans({}, 'NowoCrmKitBundle'),
    dialog_testid: 'crm-import-dialog',
    dialog_modifier: 'crm-kit-import-dialog',
    dialog_attr: {
        'data-crm-import-dialog': dialog.url,
        'data-loading': 'import.dialog.loading'|trans({}, 'NowoCrmKitBundle'),
        'data-failed': 'import.dialog.failed'|trans({}, 'NowoCrmKitBundle'),
        'data-expired': 'import.dialog.expired'|trans({}, 'NowoCrmKitBundle'),
        'data-reload': 'import.dialog.reload'|trans({}, 'NowoCrmKitBundle'),
        'data-denied': 'import.dialog.denied'|trans({}, 'NowoCrmKitBundle'),
        'data-conflict-retry': 'import.dialog.conflict_retry'|trans({}, 'NowoCrmKitBundle'),
        'data-conflict-reload': 'import.dialog.conflict_reload'|trans({}, 'NowoCrmKitBundle'),
        'data-open-page': 'import.dialog.open_page'|trans({}, 'NowoCrmKitBundle'),
        'data-notice-class': nowo_ui_class('flash_error', 'NowoCrmKitBundle'),
        'data-reload-class': nowo_ui_class('btn_secondary', 'NowoCrmKitBundle'),
    }|merge(nowo_ui_remote_dialog_reopen_attrs('crm-import-dialog')),
    bundle: 'NowoCrmKitBundle',
} only %}
    {% block body %}
        <p class="{{ nowo_ui_class('muted', 'NowoCrmKitBundle') }}" role="status" data-part="status">{{ 'import.dialog.loading'|trans({}, 'NowoCrmKitBundle') }}</p>
    {% endblock %}
    {% block footer %}
        <button type="button" class="{{ nowo_ui_class('btn_secondary', 'NowoCrmKitBundle') }}" data-crm-import-close data-testid="crm-import-dialog-cancel">{{ 'import.dialog.cancel'|trans({}, 'NowoCrmKitBundle') }}</button>
    {% endblock %}
{% endembed %}
<script src="{{ asset('js/nowo-crm-import.js', 'nowo_crm_kit') }}" defer></script>

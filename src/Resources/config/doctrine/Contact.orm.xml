<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\CrmKitBundle\Domain\Model\Contact" table="crm_contact">
        <unique-constraints>
            <unique-constraint name="crm_contact_email" columns="tenant_id,email_key"/>
        </unique-constraints>
        <indexes>
            <index name="crm_contact_sort" columns="tenant_id,status,sort_key"/>
            <index name="crm_contact_owner" columns="tenant_id,owner_id"/>
            <index name="crm_contact_keyset_name" columns="tenant_id,status,sort_key,id"/>
            <index name="crm_contact_keyset_updated" columns="tenant_id,status,updated_at,id"/>
        </indexes>
        <field name="firstName" column="first_name" type="string" length="120" nullable="true"/>
        <field name="lastName" column="last_name" type="string" length="120" nullable="true"/>
        <field name="displayName" column="display_name" type="string" length="241"/>
        <field name="sortKey" column="sort_key" type="string" length="241"/>
        <field name="emailKey" column="email_key" type="string" length="254" nullable="true"/>
        <field name="mobile" column="mobile" type="string" length="40" nullable="true"/>
        <field name="jobTitle" column="job_title" type="string" length="120" nullable="true"/>
        <field name="erasedAt" column="erased_at" type="nowo_crm_utc_datetime" nullable="true"/>
    </entity>
</doctrine-mapping>

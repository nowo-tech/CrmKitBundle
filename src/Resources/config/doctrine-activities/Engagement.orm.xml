<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\CrmKitBundle\Domain\Model\Engagement\Engagement" table="crm_engagement">
        <indexes>
            <index name="crm_engagement_primary" columns="tenant_id,subject_type,subject_id"/>
            <index name="crm_engagement_time" columns="tenant_id,occurred_at"/>
            <index name="crm_engagement_author" columns="tenant_id,author_id,occurred_at"/>
        </indexes>
        <id name="id" column="id" type="string" length="36"><generator strategy="NONE"/></id>
        <field name="tenantId" column="tenant_id" type="string" length="128"/>
        <field name="kind" column="kind" type="string" length="24" enum-type="Nowo\CrmKitBundle\Domain\Enum\ActivityKind"/>
        <field name="subjectType" column="subject_type" type="string" length="16" enum-type="Nowo\CrmKitBundle\Domain\Enum\SubjectType"/>
        <field name="subjectId" column="subject_id" type="string" length="36"/>
        <field name="occurredAt" column="occurred_at" type="nowo_crm_utc_datetime"/>
        <field name="endsAt" column="ends_at" type="nowo_crm_utc_datetime" nullable="true"/>
        <field name="timezone" column="timezone" type="string" length="64" nullable="true"/>
        <field name="title" column="title" type="string" length="200" nullable="true"/>
        <field name="body" column="body" type="text" nullable="true"/>
        <field name="direction" column="direction" type="string" length="8" nullable="true" enum-type="Nowo\CrmKitBundle\Domain\Enum\ActivityDirection"/>
        <field name="outcome" column="outcome" type="string" length="32" nullable="true"/>
        <field name="durationMinutes" column="duration_minutes" type="integer" nullable="true"/>
        <field name="place" column="place" type="string" length="200" nullable="true"/>
        <field name="cancelled" column="cancelled" type="boolean"/>
        <field name="sequence" column="ics_sequence" type="integer"/>
        <field name="authorId" column="author_id" type="string" length="128" nullable="true"/>
        <field name="version" column="version" type="integer" version="true"/>
        <field name="createdAt" column="created_at" type="nowo_crm_utc_datetime"/>
        <field name="updatedAt" column="updated_at" type="nowo_crm_utc_datetime_micro"/>
    </entity>
</doctrine-mapping>

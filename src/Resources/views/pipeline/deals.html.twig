{#
  The deals (0.3.0): UiKit list scaffold with its filters and the boards of the deal funnels. 0.10.2: numbered pages
  (UiKit pager, "Showing x–y of N") instead of the keyset "next page" link; `next` stays for a host template that
  overrides this one and is always null. Variables: page (ListPage), funnels (list of FunnelView), next (null).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}

{% block nowo_ui_content %}
    {%- set _d = 'NowoCrmKitBundle' -%}
    {%- set _b = page.bundle -%}
    {% if funnels is not empty %}
        <p data-testid="crm-boards">{% for f in funnels %}<a href="{{ path('nowo_crm_kit_deal_board', {id: f.id}) }}">{{ f.name }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
    {% endif %}
    {{ parent() }}
    {% if next %}<p><a href="{{ next }}" data-testid="crm-deals-next">{{ 'list.next'|trans({}, _d) }}</a></p>{% endif %}
{% endblock %}

{#
  0.10.3 (UI-PATTERNS §16, Beacon D-20261105-54): a part of the HubSpot mapping step as a table — the HubSpot
  property (or list) in the row header, its CRM field (or tag) select in the cell; UiKit `table` in its scroll wrapper,
  two columns that stay readable at phone width (the label wraps, the select takes the rest). The row header is the
  select's own <label> (form_label, `for` = the select), so the select is named by the property; the table caption
  names the object.
  Variables: rows (list of FormView, the selects), caption (the table caption), head (header of the first column),
  bundle.
#}
{%- set _d = 'NowoCrmKitBundle' -%}
{%- set _b = bundle -%}
<div class="{{ nowo_ui_class('table_wrap', _b) }}">
    <table class="{{ nowo_ui_class('table', _b) }}">
        <caption>{{ caption }}</caption>
        <thead>
            <tr>
                <th scope="col">{{ head }}</th>
                <th scope="col">{{ 'import.hubspot.mapping.target'|trans({}, _d) }}</th>
            </tr>
        </thead>
        <tbody>
            {% for _row in rows %}
                <tr data-testid="crm-hubspot-mapping-row">
                    <th scope="row">{{ form_label(_row, null) }}</th>
                    <td>{{ form_widget(_row, {attr: _row.vars.attr|merge({class: ((_row.vars.attr.class ?? '') ~ ' nowo-ui-input--full')|trim})}) }}{{ form_errors(_row) }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\CrmKitBundle\Domain\Model\FieldDefinition" table="crm_field">
        <unique-constraints>
            <unique-constraint name="crm_field_key" columns="tenant_id,subject_type,field_key"/>
        </unique-constraints>
        <id name="id" column="id" type="string" length="36"><generator strategy="NONE"/></id>
        <field name="tenantId" column="tenant_id" type="string" length="128"/>
        <field name="subjectType" column="subject_type" type="string" length="16" enum-type="Nowo\CrmKitBundle\Domain\Enum\SubjectType"/>
        <field name="fieldKey" column="field_key" type="string" length="40"/>
        <field name="label" column="label" type="string" length="80"/>
        <field name="type" column="type" type="string" length="16" enum-type="Nowo\CrmKitBundle\Domain\Enum\FieldType"/>
        <field name="choices" column="choices" type="json"/>
        <field name="required" column="required" type="boolean"/>
        <field name="position" column="position" type="integer"/>
        <field name="archived" column="archived" type="boolean"/>
        <field name="version" column="version" type="integer" version="true"/>
        <field name="createdAt" column="created_at" type="nowo_crm_utc_datetime"/>
    </entity>
</doctrine-mapping>

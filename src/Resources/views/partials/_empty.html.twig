{#
  0.10.2 (Beacon UI-PATTERNS §11): the empty state of the CRM lists. The UiKit `empty` partial takes it over for the
  NowoCrmKitBundle (theme.bundles.NowoCrmKitBundle.partials.empty, prepended by the bundle; a host entry wins): the
  UiKit 2.73 markup of a View\EmptyState, with the extra actions the controller put on the request
  (RecordController::EMPTY_ACTIONS: Import next to create) after its own action, in the same action row. Without
  extra actions, or for the 1.x message-only call, it is UiKit's partial unchanged. Same variables as the UiKit partial.
#}
{%- set _extra = (app is defined and app and app.request ? app.request.attributes.get('_nowo_crm_kit_empty_actions') : null)|default([]) -%}
{%- if _extra is empty or empty is not defined or not empty -%}
    {{- include('@NowoUiKitBundle/partials/_empty.html.twig', _context, false) -}}
{%- else -%}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set framework = framework|default(null) %}
{% set bundle = bundle|default(null) %}
{% set _t = nowo_ui_theme|default(null) %}
{% set _pt = nowo_ui_page_type|default(null) %}
{% set _class = _t ? _t.macroClasses('empty', ui.empty(framework), bundle, _pt) : ui.empty(framework) %}
{% set _title = empty.title is null ? null : (empty.title.key is defined ? empty.title.key|trans(empty.title.params, empty.title.domain) : empty.title) %}
{% set _message = empty.message is null ? 'empty.default'|trans({}, 'NowoUiKitBundle') : (empty.message.key is defined ? empty.message.key|trans(empty.message.params, empty.message.domain) : empty.message) %}
{%- set _icon = empty.icon is defined ? empty.icon : null %}
{%- set _action_partial = _t ? _t.partial('action', bundle) : '@NowoUiKitBundle/partials/_action.html.twig' %}
    <div class="{{ _class }}{{ _icon ? ' nowo-ui-empty--illustrated' }}"{{ _t ? _t.renderAttributes('empty', bundle, {}, _pt)|raw }}{% if region|default(null) %} data-nowo-ui-region="{{ region }}"{% endif %}>
        {%- if _icon %}<span class="nowo-ui-empty__icon" aria-hidden="true">{{ include('@NowoUiKitBundle/components/_icon.html.twig', {name: _icon, label: ''}, false) }}</span>{% endif %}
        {% if _title %}<p class="nowo-ui-empty__title">{{ _title }}</p>{% endif %}
        <p class="nowo-ui-empty__message">{{ _message }}</p>
        <div class="nowo-ui-empty__action">
            {%- if empty.action %}{{ include(_action_partial, {action: empty.action, context: 'toolbar', framework: framework, bundle: bundle, nowo_ui_page_type: _pt}, false) }}{% endif -%}
            {%- for _action in _extra %}{{ include(_action_partial, {action: _action, context: 'toolbar', framework: framework, bundle: bundle, nowo_ui_page_type: _pt}, false) }}{% endfor -%}
        </div>
    </div>
{%- endif -%}

<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\CrmKitBundle\Domain\Model\HostLink" table="crm_host_link">
        <unique-constraints>
            <unique-constraint name="crm_host_link_key" columns="tenant_id,subject_type,subject_id,host_type,host_id"/>
        </unique-constraints>
        <indexes>
            <index name="crm_host_link_host" columns="tenant_id,host_type,host_id"/>
        </indexes>
        <id name="id" column="id" type="string" length="36"><generator strategy="NONE"/></id>
        <field name="tenantId" column="tenant_id" type="string" length="128"/>
        <field name="subjectType" column="subject_type" type="string" length="16" enum-type="Nowo\CrmKitBundle\Domain\Enum\SubjectType"/>
        <field name="subjectId" column="subject_id" type="string" length="36"/>
        <field name="hostType" column="host_type" type="string" length="64"/>
        <field name="hostId" column="host_id" type="string" length="128"/>
        <field name="label" column="label" type="string" length="200" nullable="true"/>
        <field name="createdById" column="created_by_id" type="string" length="128" nullable="true"/>
        <field name="createdAt" column="created_at" type="nowo_crm_utc_datetime"/>
    </entity>
</doctrine-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\CrmKitBundle\Domain\Model\Pipeline\Funnel" table="crm_funnel">
        <indexes>
            <index name="crm_funnel_list" columns="tenant_id,kind,archived,position"/>
        </indexes>
        <id name="id" column="id" type="string" length="36"><generator strategy="NONE"/></id>
        <field name="tenantId" column="tenant_id" type="string" length="128"/>
        <field name="kind" column="kind" type="string" length="16" enum-type="Nowo\CrmKitBundle\Domain\Enum\FunnelKind"/>
        <field name="subjectType" column="subject_type" type="string" length="16" nullable="true" enum-type="Nowo\CrmKitBundle\Domain\Enum\SubjectType"/>
        <field name="name" column="name" type="string" length="120"/>
        <field name="position" column="position" type="integer"/>
        <field name="archived" column="archived" type="boolean"/>
        <field name="version" column="version" type="integer" version="true"/>
        <field name="createdAt" column="created_at" type="nowo_crm_utc_datetime"/>
        <field name="updatedAt" column="updated_at" type="nowo_crm_utc_datetime_micro"/>
    </entity>
</doctrine-mapping>

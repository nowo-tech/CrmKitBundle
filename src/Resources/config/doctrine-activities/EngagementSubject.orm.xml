<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\CrmKitBundle\Domain\Model\Engagement\EngagementSubject" table="crm_engagement_subject">
        <unique-constraints>
            <unique-constraint name="crm_engagement_subject_unique" columns="engagement_id,subject_type,subject_id"/>
        </unique-constraints>
        <indexes>
            <index name="crm_engagement_subject_record" columns="tenant_id,subject_type,subject_id"/>
        </indexes>
        <id name="id" column="id" type="string" length="36"><generator strategy="NONE"/></id>
        <field name="tenantId" column="tenant_id" type="string" length="128"/>
        <field name="engagementId" column="engagement_id" type="string" length="36"/>
        <field name="subjectType" column="subject_type" type="string" length="16" enum-type="Nowo\CrmKitBundle\Domain\Enum\SubjectType"/>
        <field name="subjectId" column="subject_id" type="string" length="36"/>
        <field name="primary" column="is_primary" type="boolean"/>
    </entity>
</doctrine-mapping>

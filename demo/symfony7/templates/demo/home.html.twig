{% extends 'base.html.twig' %}

{% block title %}Overview{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        {% if is_granted('ROLE_USER') %}
            <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('nowo_crm_kit_list', {type: 'companies'}) }}" data-testid="demo-open-companies">Companies</a>
        {% else %}
            <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('demo_login') }}" data-testid="demo-login">Sign in</a>
        {% endif %}
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'CRM Kit Bundle',
        intro: 'Companies and contacts with custom fields, tags, owners, notes, a timeline, CSV / vCard import and duplicate merging. Sign in as one of the demo people (password "demo").',
        toolbar: _toolbar,
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Demo people', intro: 'Link a company to the demo projects P-1, P-2 or P-3 to see the host panel on its 360° page.', kind: 'table', testid: 'demo-people', people: people} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead><tr><th scope="col">User</th><th scope="col">Person</th><th scope="col" class="nowo-ui-cell--wrap">What they can do</th></tr></thead>
                <tbody>
                    {% for person in people %}
                        <tr><th scope="row"><code class="nowo-ui-code">{{ person.user }}</code></th><td>{{ person.name }}</td><td class="nowo-ui-cell--wrap">{{ person.roles }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Runtime', kind: 'detail', worker: worker} %}
        {% block section_body %}
            <p>FrankenPHP: {{ worker ? 'worker mode (kernel kept alive, not reset)' : 'classic mode' }}.</p>
        {% endblock %}
    {% endembed %}
{% endblock %}

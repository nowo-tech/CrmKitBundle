# PHPStan configuration for CRM Kit Bundle (level max).
#
# Run: make phpstan
parameters:
    level: max
    paths:
        - src
        - tests
    bootstrapFiles:
        - tests/bootstrap.php
    # The DI configurator functions (service(), param()…) live in this class file, not in an autoloaded file: a
    # parallel worker that never loads the class reports function.notFound depending on how files are split.
    scanFiles:
        - vendor/symfony/dependency-injection/Loader/Configurator/ContainerConfigurator.php
    excludePaths:
        analyseAndScan:
            - demo/*
            - vendor/*
            - tests/Stubs/*
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors: []

includes:
  # 0.3.0: the SearchKit groups need SearchKit (PHP >= 8.3); left out where it is not installed.
  - phpstan-search-kit.php
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  # worker-strict includes default worker rules + request-superglobal hygiene (kernel not reset).
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker-strict.neon
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-hardening.neon

{#
  The "Link to" form of the 360° page (0.7.0). Variables: form (FormView of HostLinkType), action, search_url (the link
  picker's endpoint, or null). With a picker the id field is wrapped in the UiKit combobox (opt-in runtime `combobox`):
  it searches by name and writes the picked `<type>:<id>` into the hidden `hostRef`; typing again empties it. Without
  JavaScript, or when nothing is picked, the field submits the typed text as the id of the chosen type, as before.
#}
{%- set _b = 'NowoCrmKitBundle' -%}
<section class="{{ nowo_ui_class('card', _b) }}" data-testid="crm-link-form">
    <div class="{{ nowo_ui_class('card_body', _b) }}">
        <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'link.add'|trans({}, _b) }}</h2>
        {{ form_start(form, {action: action}) }}
        {% if form.vars.errors|length > 0 %}<div class="{{ nowo_ui_class('flash_error', _b) }}" role="alert">{{ form_errors(form) }}</div>{% endif %}
        {{ form_row(form.hostType) }}
        {% if search_url and form.hostRef is defined %}
            {%- set _field = form.hostId -%}
            <div class="{{ nowo_ui_class('form_row', _b) }}" data-testid="crm-link-picker">
                {{ form_label(_field) }}
                {{ include(nowo_ui_partial('combobox', _b), {id: _field.vars.id ~ '_picker', input: form_widget(_field), url: search_url, min_length: 2, value_input: form.hostRef.vars.id, labels: {list: 'link.form.object_list'|trans({}, _b)}, bundle: _b}, with_context: false) }}
                {{ form_help(_field) }}
                {{ form_errors(_field) }}
            </div>
            {{ form_widget(form.hostRef) }}
        {% endif %}
        {% for child in form %}{% if not child.rendered %}{{ form_row(child) }}{% endif %}{% endfor %}
        <div class="{{ nowo_ui_class('form_actions', _b) }}"><button type="submit" class="{{ nowo_ui_class('btn_secondary', _b) }}">{{ 'link.save'|trans({}, _b) }}</button></div>
        {{ form_end(form) }}
        {% if search_url and form.hostRef is defined %}{{ include(nowo_ui_partial('scripts', _b), {script_names: ['combobox']}) }}{% endif %}
    </div>
</section>

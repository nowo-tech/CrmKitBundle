{#
  A list of companies or contacts (contract section 11.1): UiKit list scaffold (filters, server sort, pages, row
  actions, phone cards) and the focus-mode toggle; 0.4.0: the import modal, for someone who may import (opened by the
  page action "Import") and a notice linking the person's unfinished imports. Variables: page (ListPage),
  crm_import_dialog ({url, unfinished: {total, imports: [{id, file}]}} or null), crm_record_dialog (0.8.0,
  `ui.record_create: dialog`: {id, title} or null): one empty UiKit remote form dialog shell that "New company /
  contact" fills on demand with the form page's fragment (record/_form_dialog.html.twig); nothing of the form is in the
  list page.
#}
{% extends '@NowoUiKit/page/list.html.twig' %}

{#- 0.6.0: ui.filters_slot, a host template that wraps the filters region (bottom sheet on phones...): it gets page, form
    (the filter FormView) and filters (the rendered UiKit filters markup) -#}
{% block nowo_ui_list_filters %}
    {% if crm_filters_slot|default(null) and page.filters %}
        {%- set _filters_html -%}{{ parent() }}{%- endset -%}
        {{ include(crm_filters_slot, {page: page, form: page.filters, filters: _filters_html}, false) }}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block nowo_ui_content %}
    <div class="crm-kit-toolbar" data-testid="crm-focus">{{ include(nowo_ui_partial('focus_mode_toggle', page.bundle), {area: 'crm', bundle: page.bundle}) }}</div>
    {%- set _unfinished = (crm_import_dialog|default(null)).unfinished ?? null -%}
    {% if _unfinished is not null and _unfinished.total > 0 %}
        <div class="{{ nowo_ui_class('flash_info', page.bundle) }}" role="status" data-testid="crm-import-unfinished">
            <p>{{ 'import.unfinished'|trans({'%count%': _unfinished.total}, 'NowoCrmKitBundle') }}</p>
            <ul>
                {% for _import in _unfinished.imports %}<li><a href="{{ path('nowo_crm_kit_import_show', {id: _import.id}) }}" data-testid="crm-import-unfinished-link">{{ _import.file }}</a></li>{% endfor %}
            </ul>
        </div>
    {% endif %}
    {{ parent() }}
    {% if crm_record_dialog|default(null) is not null %}{{ include(nowo_ui_partial('remote_form_dialog', page.bundle), {id: crm_record_dialog.id, title: crm_record_dialog.title, size: 'lg', attr: {'data-testid': crm_record_dialog.id}, bundle: page.bundle}, false) }}{% endif %}
    {% if crm_import_dialog|default(null) is not null %}{{ include('@NowoCrmKit/import/_dialog_shell.html.twig', {dialog: crm_import_dialog}, false) }}{% endif %}
{% endblock %}

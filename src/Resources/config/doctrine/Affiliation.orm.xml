<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\CrmKitBundle\Domain\Model\Affiliation" table="crm_affiliation">
        <unique-constraints>
            <unique-constraint name="crm_affiliation_pair" columns="contact_id,company_id"/>
        </unique-constraints>
        <indexes>
            <index name="crm_affiliation_company" columns="tenant_id,company_id"/>
        </indexes>
        <id name="id" column="id" type="string" length="36"><generator strategy="NONE"/></id>
        <field name="tenantId" column="tenant_id" type="string" length="128"/>
        <field name="contactId" column="contact_id" type="string" length="36"/>
        <field name="companyId" column="company_id" type="string" length="36"/>
        <field name="role" column="role" type="string" length="120" nullable="true"/>
        <field name="primary" column="is_primary" type="boolean"/>
        <field name="createdAt" column="created_at" type="nowo_crm_utc_datetime"/>
    </entity>
</doctrine-mapping>

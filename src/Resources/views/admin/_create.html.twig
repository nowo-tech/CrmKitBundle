{#
  Create in a dialog (0.6.1, `ui.admin_create: dialog`) on Tags and Custom fields: one UiKit confirm_dialog with its
  anatomy per create action of page.header.actions (data-nowo-confirm-open / data-nowo-confirm-target, UiKit
  js/nowo-ui-confirm.js), the form in the body, Cancel and the one primary in the footer. The dialog of an invalid
  submission (422) or of the `?new=1` deep link opens on load (UiKit `open_modal_on_load` + js/nowo-ui-open-modal.js);
  without JavaScript the same form renders in a card inside <noscript> (`?new=1`, the action's href, is the no-JS
  fallback). Same routes, field names and CSRF token as the inline form.

  Variables: create ({dialogs: [{form, id, title, submit, action, testid}], open: dialog id or null, clear: 'new' |
  false, fallback: {form, title, submit, action, testid} or null}).
#}
{%- set _d = 'NowoCrmKitBundle' -%}
{% for _dialog in create.dialogs %}
    {%- set _form_id = _dialog.id ~ '-form' -%}
    {% embed nowo_ui_partial('confirm_dialog', 'NowoCrmKitBundle') with {
        only_dialog: true,
        anatomy: true,
        phone: 'sheet',
        dialog_id: _dialog.id,
        title: _dialog.title|trans({}, _d),
        close_label: 'form.cancel'|trans({}, _d),
        dialog_testid: _dialog.testid ~ '-dialog',
        dialog_modifier: 'crm-kit-create-dialog',
        form: _dialog.form,
        form_id: _form_id,
        action: _dialog.action,
        submit: _dialog.submit,
        testid: _dialog.testid,
        bundle: _d,
    } only %}
        {% block body %}
            <div data-testid="{{ testid }}">
                {{ form_start(form, {action: action, attr: {id: form_id, class: nowo_ui_class('form', bundle)}}) }}
                {% if form.vars.errors|length > 0 %}<div class="{{ nowo_ui_class('flash_error', bundle) }}" role="alert">{{ form_errors(form) }}</div>{% endif %}
                {% for child in form %}{% if not child.rendered %}{{ form_row(child) }}{% endif %}{% endfor %}
                {{ form_end(form) }}
            </div>
        {% endblock %}
        {% block footer %}
            <button type="button" class="{{ nowo_ui_class('btn_secondary', bundle) }}" data-confirm-dialog-close data-nowo-confirm-close data-testid="{{ testid }}-cancel">{{ 'form.cancel'|trans({}, bundle) }}</button>
            <button type="submit" form="{{ form_id }}" class="{{ nowo_ui_class('btn_primary', bundle) }}" data-testid="{{ testid }}-submit">{{ submit|trans({}, bundle) }}</button>
        {% endblock %}
    {% endembed %}
{% endfor %}
{% if create.open %}
    {{ include('@NowoUiKitBundle/partials/_open_modal_on_load.html.twig', {modal: create.open, param: create.clear}, false) }}
    <script src="{{ asset('js/nowo-ui-open-modal.js', 'nowo_ui_kit') }}" defer></script>
{% endif %}
{% if create.fallback %}
    <noscript>{{ include('@NowoCrmKit/_form.html.twig', {form: create.fallback.form, title: create.fallback.title, submit: create.fallback.submit, action: create.fallback.action, testid: create.fallback.testid}, false) }}</noscript>
{% endif %}

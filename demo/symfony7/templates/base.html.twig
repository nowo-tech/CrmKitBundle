{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (UiKit's default theme, no CSS framework, no
    CDN). This file only declares the demo. The CRM pages render in it too (nowo_ui_kit.layouts.admin). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _nav = [{label: 'Overview', route: 'demo_home', section: 'CRM Kit'}] %}
{% if is_granted('ROLE_USER') %}
    {% set _nav = _nav|merge([
        {label: 'Companies', route: 'nowo_crm_kit_list', params: {type: 'companies'}, section: 'CRM', testid: 'demo-nav-companies'},
        {label: 'Contacts', route: 'nowo_crm_kit_list', params: {type: 'contacts'}, section: 'CRM', testid: 'demo-nav-contacts'},
    ]) %}
    {% if is_granted('ROLE_SALES') %}
        {% set _nav = _nav|merge([
            {label: 'Import', route: 'nowo_crm_kit_import', active: ['nowo_crm_kit_import*'], section: 'CRM', testid: 'demo-nav-import'},
        ]) %}
    {% endif %}
    {% if is_granted('ROLE_ADMIN') %}
        {% set _nav = _nav|merge([
            {label: 'Tags', route: 'nowo_crm_kit_tags', active: ['nowo_crm_kit_tag*'], section: 'Admin'},
            {label: 'Custom fields', route: 'nowo_crm_kit_fields', active: ['nowo_crm_kit_field*'], section: 'Admin'},
            {label: 'Settings', route: 'nowo_crm_kit_settings', section: 'Admin'},
        ]) %}
    {% endif %}
    {% set _nav = _nav|merge([{label: 'Sign out', route: 'demo_logout', active: [], section: 'Account', testid: 'demo-logout'}]) %}
{% else %}
    {% set _nav = _nav|merge([{label: 'Sign in', route: 'demo_login', section: 'Account', testid: 'demo-nav-login'}]) %}
{% endif %}
{% set nowo_ui_demo_platform = {
    bundle: 'CRM Kit',
    home_route: 'demo_home',
    repository: 'https://github.com/nowo-tech/CrmKitBundle',
    translation_domain: false,
    nav: _nav,
} %}
{% block nowo_ui_document_title %}{% block title %}CRM Kit Bundle demo{% endblock %} — Symfony 7{% endblock %}

{% block nowo_ui_demo_platform_aside_end %}
    {% if is_granted('ROLE_USER') %}
        <p class="nowo-ui-muted">Signed in as <span data-testid="demo-user">{{ app.user.userIdentifier }}</span></p>
    {% endif %}
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
